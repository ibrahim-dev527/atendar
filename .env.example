# ---------------------------------------------------------------------------
# Atendar | environment variables
# Copy to .env for local use. On Vercel, add these in Project > Settings >
# Environment Variables. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# PUBLIC (safe to ship to the browser: protected by RLS + RPC rules)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# PUBLIC site settings
SITE_URL=https://your-attendance-site.vercel.app

# SECRET: used ONLY inside Supabase Edge Functions (set with
# `supabase secrets set`). Supabase injects it automatically at runtime.
# Do NOT put it in Vercel's browser-exposed variables or in any frontend file.
# SUPABASE_SERVICE_ROLE_KEY=
# Optional Edge Function settings:
# ALLOWED_ORIGIN=https://your-attendance-site.vercel.app
# INVITE_REDIRECT_URL=https://your-attendance-site.vercel.app/admin/login.html
